{
	"private": true,
	"workspaces": {
		"packages": [
			"live-status-gateway-api",
			"*-integration",
			"*-gateway",
			"corelib",
			"openapi",
			"shared-lib",
			"job-worker",
			"meteor-lib",
			"documentation",
			"webui"
		]
	},
	"scripts": {
		"prepare": "husky",
		"build": "run build:prepare && run build:main",
		"build:prepare": "(rimraf */dist */*.tsbuildinfo || true) && lerna run build:prepare",
		"build:main": "tsc --build tsconfig.build.json",
		"build:all": "run build && lerna run build --scope @sofie-automation/openapi",
		"build:try": "run build || true",
		"build:single": "run build:prepare && tsc --build",
		"watch": "run build:main --watch",
		"stage-versions": "git add -u \"*/package.json\" \"*/CHANGELOG.md\" lerna.json yarn.lock",
		"set-version": "lerna version --exact --no-changelog --no-git-tag-version --no-push --yes",
		"set-version-and-commit": "lerna version --exact --no-changelog --no-changelog --no-commit-hooks --force-publish='*' --no-push --yes",
		"set-version-and-changelog": "lerna version --exact --force-publish --conventional-commits --no-git-tag-version --no-push --yes",
		"validate:dependencies": "yarn npm audit --environment production && run license-validate",
		"validate:dev-dependencies": "yarn npm audit --environment development",
		"license-validate": "sofie-licensecheck",
		"lint": "yarn lint:eslint && yarn lint:prettier",
		"unit": "lerna run --concurrency 2 --stream unit --ignore @sofie-automation/openapi -- --coverage=false",
		"test": "lerna run --concurrency 2 --stream test -- --coverage=false",
		"docs:typedoc": "typedoc .",
		"docs:serve": "lerna run --scope sofie-documentation --stream start",
		"watch-for-worker-changes": "nodemon --delay 2.5 --watch job-worker/dist --watch corelib/dist --watch shared-lib/dist --watch blueprints-integration/dist --watch server-core-integration/dist ../scripts/meteor-force-restart.js",
		"generate-schema-types": "node scripts/schema-types.mjs",
		"prettier": "cd $INIT_CWD && \"$PROJECT_CWD/node_modules/.bin/prettier\"",
		"eslint": "cd $INIT_CWD && \"$PROJECT_CWD/node_modules/.bin/eslint\"",
		"lint:eslint": "eslint .",
		"lint:prettier": "prettier --check .",
		"lint:fix": "yarn lint:eslint --fix && yarn lint:prettier --write"
	},
	"devDependencies": {
		"@babel/core": "^7.29.7",
		"@babel/plugin-transform-modules-commonjs": "^7.29.7",
		"@sofie-automation/code-standard-preset": "3.2.2-nightly-rjmunro-setup-script-20260507-133943-232a96d",
		"@types/amqplib": "0.10.6",
		"@types/debug": "^4.1.13",
		"@types/ejson": "^2.2.2",
		"@types/jest": "^30.0.0",
		"@types/node": "^22.19.21",
		"@types/object-path": "^0.11.4",
		"@types/underscore": "^1.13.0",
		"babel-jest": "^30.4.1",
		"eslint": "^9",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-yml": "^3.4.0",
		"husky": "^9.1.7",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jest-mock-extended": "^4.0.1",
		"json-schema-to-typescript": "^15.0.4",
		"lerna": "^9.0.7",
		"lint-staged": "^17.0.2",
		"nodemon": "^3.1.14",
		"open-cli": "^9.0.0",
		"pinst": "^3.0.0",
		"prettier": "^3",
		"rimraf": "^6.1.3",
		"semver": "^7.8.4",
		"ts-jest": "29.4.9",
		"ts-node": "^10.9.2",
		"typedoc": "^0.27.9",
		"typescript": "~6.0"
	},
	"name": "packages",
	"packageManager": "yarn@4.17.0",
	"resolutions": {
		"timecode@0.0.4": "patch:timecode@npm%3A0.0.4#./.yarn/patches/timecode-npm-0.0.4-82bde9e6fe.patch",
		"@hyperjump/json-schema-core@^0.28.0": "patch:@hyperjump/json-schema-core@npm%3A0.28.5#./.yarn/patches/@hyperjump-json-schema-core-npm-0.28.5-e8b590eb0d.patch",
		"@hyperjump/json-pointer@^0.9.4": "patch:@hyperjump/json-pointer@npm%3A0.9.8#./.yarn/patches/@hyperjump-json-pointer-npm-0.9.8-edc0d22296.patch",
		"@hyperjump/json-pointer@^0.9.2": "patch:@hyperjump/json-pointer@npm%3A0.9.8#./.yarn/patches/@hyperjump-json-pointer-npm-0.9.8-edc0d22296.patch",
		"@hyperjump/pact@^0.2.3": "patch:@hyperjump/pact@npm%3A0.2.5#./.yarn/patches/@hyperjump-pact-npm-0.2.5-a816d03fba.patch"
	},
	"dependenciesMeta": {
		"esbuild": {
			"built": true
		},
		"nx": {
			"built": true
		}
	},
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx,mjs,cjs}": [
			"eslint --fix"
		]
	},
	"prettier": "@sofie-automation/code-standard-preset/prettier.config.mjs"
}
